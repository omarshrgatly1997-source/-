//@version=6
indicator("Omar_trad2025", shorttitle="Omar_trad2025", overlay=true, max_lines_count=100, max_labels_count=100)

// ---------------- Trend (1 hour timeframe) ----------------
grpTrend   = "Trend - 1H"
trendTF    = input.timeframe("60", "Trend timeframe", group=grpTrend)
fastLen    = input.int(50, "Fast EMA", group=grpTrend)
slowLen    = input.int(200, "Slow EMA", group=grpTrend)

[emaFast1h, emaSlow1h] = request.security(syminfo.tickerid, trendTF, [ta.ema(close, fastLen), ta.ema(close, slowLen)], lookahead=barmerge.lookahead_off)

trendUp   = emaFast1h > emaSlow1h
trendDown = emaFast1h < emaSlow1h

// ---------------- Major swing high/low (1 hour timeframe) ----------------
grpSwing1h    = "Swing High/Low - 1H"
pivotLeft1h   = input.int(5, "Pivot left bars", group=grpSwing1h)
pivotRight1h  = input.int(5, "Pivot right bars (confirmation)", group=grpSwing1h)

[ph1h, pl1h, time1h] = request.security(syminfo.tickerid, trendTF, [ta.pivothigh(high, pivotLeft1h, pivotRight1h), ta.pivotlow(low, pivotLeft1h, pivotRight1h), time[pivotRight1h]], lookahead=barmerge.lookahead_off)

var float major1hHigh     = na
var int   major1hHighTime = na
var bool  high1hBroken    = true

var float major1hLow      = na
var int   major1hLowTime  = na
var bool  low1hBroken     = true

if not na(ph1h)
    if na(major1hHigh) or high1hBroken or ph1h > major1hHigh
        major1hHigh     := ph1h
        major1hHighTime := time1h
        high1hBroken    := false

if not na(pl1h)
    if na(major1hLow) or low1hBroken or pl1h < major1hLow
        major1hLow     := pl1h
        major1hLowTime := time1h
        low1hBroken    := false

if not na(major1hHigh) and close > major1hHigh
    high1hBroken := true

if not na(major1hLow) and close < major1hLow
    low1hBroken := true

var line l1hHigh = na
var line l1hLow  = na

if not na(major1hHigh) and not high1hBroken
    line.delete(l1hHigh)
    l1hHigh := line.new(major1hHighTime, major1hHigh, time, major1hHigh, xloc=xloc.bar_time, color=color.blue, width=1)
else
    line.delete(l1hHigh)

if not na(major1hLow) and not low1hBroken
    line.delete(l1hLow)
    l1hLow := line.new(major1hLowTime, major1hLow, time, major1hLow, xloc=xloc.bar_time, color=color.blue, width=1)
else
    line.delete(l1hLow)

// ---------------- Swing high/low (5 minute timeframe) ----------------
// Run this indicator on a 5-minute chart so it reads the correct high/low for that timeframe
grpSwing    = "Swing High/Low - 5M"
pivotLeft   = input.int(5, "Pivot left bars", group=grpSwing)
pivotRight  = input.int(5, "Pivot right bars (confirmation)", group=grpSwing)

ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastPivotHigh     = na
var int   lastPivotHighTime = na
var float lastPivotLow      = na
var int   lastPivotLowTime  = na
var bool  highBroken        = true
var bool  lowBroken         = true

// The major high/low stays fixed once set. A new pivot only replaces it once
// the current one has been broken by price (or if the new pivot is even more
// extreme while still unbroken). This keeps only the real, still-standing
// swing points instead of every small pivot.
// Anchored by time (not bar index) since price can keep an unbroken high/low
// for more than 10,000 bars, which bar-index-based lines cannot handle.
if not na(ph)
    if na(lastPivotHigh) or highBroken or ph > lastPivotHigh
        lastPivotHigh     := ph
        lastPivotHighTime := time[pivotRight]
        highBroken        := false

if not na(pl)
    if na(lastPivotLow) or lowBroken or pl < lastPivotLow
        lastPivotLow     := pl
        lastPivotLowTime := time[pivotRight]
        lowBroken        := false

if not na(lastPivotHigh) and close > lastPivotHigh
    highBroken := true

if not na(lastPivotLow) and close < lastPivotLow
    lowBroken := true

// ---------------- Fibonacci ----------------
grpFib   = "Fibonacci Levels"
lvl1     = input.float(1.0,   "Level 1",              group=grpFib)
lvl786   = input.float(0.786, "Level 0.786 (stop loss)", group=grpFib)
lvl667   = input.float(0.667, "Level 0.667 (entry)",  group=grpFib)
lvl0     = input.float(0.0,   "Level 0",              group=grpFib)
lvlExt   = input.float(-1.3,  "Extension level -1.3", group=grpFib)

// Point A = the more recent of the last major high/low (represents level 0)
// Point B = the other one, older (represents level 1)
// Direction (legUp) comes from which point is more recent, not from the 1H
// trend filter -- requiring both to agree left the entry/SL/TP zone hidden
// most of the time.
haveLeg = not na(lastPivotHigh) and not na(lastPivotLow)

float pointA     = na
float pointB     = na
int   pointBTime = na
bool  legUp      = na

if haveLeg
    if lastPivotHighTime > lastPivotLowTime
        pointA     := lastPivotHigh
        pointB     := lastPivotLow
        pointBTime := lastPivotLowTime
        legUp      := true
    else if lastPivotLowTime > lastPivotHighTime
        pointA     := lastPivotLow
        pointB     := lastPivotHigh
        pointBTime := lastPivotHighTime
        legUp      := false

validLeg = not na(pointA) and not na(pointB)

f_priceAtLevel(a, b, l) => a + (b - a) * l

priceLvl1   = validLeg ? f_priceAtLevel(pointA, pointB, lvl1)   : na
priceLvl786 = validLeg ? f_priceAtLevel(pointA, pointB, lvl786) : na
priceLvl667 = validLeg ? f_priceAtLevel(pointA, pointB, lvl667) : na
priceLvl0   = validLeg ? f_priceAtLevel(pointA, pointB, lvl0)   : na
priceLvlExt = validLeg ? f_priceAtLevel(pointA, pointB, lvlExt) : na

// Correction = price pulled back past the 0.667 level against the leg -> this is the entry point
corrected        = validLeg and (legUp ? close < priceLvl667 : close > priceLvl667)
correctionStarted = corrected and not corrected[1]

// Stop loss = price breaks past the 0.786 level (deeper than the entry)
slHit     = validLeg and (legUp ? close < priceLvl786 : close > priceLvl786)
slHitNow  = slHit and not slHit[1]

// TP1 = level 0, TP2 = extension level -1.3 (both in the leg's favorable direction)
tp1Hit    = validLeg and (legUp ? close > priceLvl0   : close < priceLvl0)
tp1HitNow = tp1Hit and not tp1Hit[1]
tp2Hit    = validLeg and (legUp ? close > priceLvlExt : close < priceLvlExt)
tp2HitNow = tp2Hit and not tp2Hit[1]

// ---------------- 5M trade stats box ----------------
// One "trade" = one entry at 0.667. It stays open until TP2 or SL closes it,
// or a new swing leg forms and resets tracking. A loss only counts if SL is
// hit before TP1 was ever reached on that trade.
var int  totalTrades = 0
var int  tp1Count    = 0
var int  tp2Count    = 0
var int  lossCount   = 0
var bool tradeOpen   = false
var bool tp1Achieved = false

newLeg = validLeg and (na(pointBTime[1]) or pointBTime != pointBTime[1])

if newLeg
    tradeOpen   := false
    tp1Achieved := false

if correctionStarted and not tradeOpen
    tradeOpen   := true
    totalTrades += 1

if tradeOpen and tp1HitNow and not tp1Achieved
    tp1Achieved := true
    tp1Count    += 1

if tradeOpen and tp2HitNow
    tp2Count  += 1
    tradeOpen := false

if tradeOpen and slHitNow
    if not tp1Achieved
        lossCount += 1
    tradeOpen := false

resolvedTrades = tp1Count + lossCount
winRateTxt     = resolvedTrades > 0 ? str.tostring(tp1Count * 100.0 / resolvedTrades, "#.#") + "%" : "-"

var table statsBox = table.new(position.top_right, 2, 6, border_width=1, border_color=color.gray, frame_color=color.gray, frame_width=1)

if barstate.islast
    table.cell(statsBox, 0, 0, "5M Stats",     text_color=color.white, bgcolor=color.new(color.blue, 30),  text_size=size.small)
    table.cell(statsBox, 1, 0, "",              text_color=color.white, bgcolor=color.new(color.blue, 30),  text_size=size.small)
    table.cell(statsBox, 0, 1, "Entries",       text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 1, str.tostring(totalTrades), text_color=color.white,  bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 2, "TP1 hits",      text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 2, str.tostring(tp1Count),    text_color=color.aqua,   bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 3, "TP2 hits",      text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 3, str.tostring(tp2Count),    text_color=color.purple, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 4, "Losses (SL)",   text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 4, str.tostring(lossCount),   text_color=color.red,    bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 5, "Win rate",      text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 5, winRateTxt,      text_color=color.lime,  bgcolor=color.new(color.black, 40), text_size=size.small)

// ---------------- Draw/update Fibonacci while no correction has happened ----------------
var line  l1     = na
var label lState = na

if validLeg and not corrected
    line.delete(l1)
    label.delete(lState)

    l1 := line.new(pointBTime, priceLvl1, time, priceLvl1, xloc=xloc.bar_time, color=color.gray, style=line.style_dashed)

    lState := label.new(bar_index, priceLvl1, "No correction - Fib active", style=label.style_label_down, color=color.blue, textcolor=color.white, size=size.small)

if corrected
    label.delete(lState)
    lState := label.new(bar_index, legUp ? low : high, "Alert: price correction", style=legUp ? label.style_label_up : label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// ---------------- Entry (0.667), stop loss (0.786), TP1 (0) and TP2 (-1.3) ----------------
var line  lEntry    = na
var line  lSL       = na
var line  lTP1      = na
var line  lTP2      = na
var label lEntryTxt = na
var label lSLTxt    = na
var label lTP1Txt   = na
var label lTP2Txt   = na

if validLeg
    line.delete(lEntry)
    line.delete(lSL)
    line.delete(lTP1)
    line.delete(lTP2)
    label.delete(lEntryTxt)
    label.delete(lSLTxt)
    label.delete(lTP1Txt)
    label.delete(lTP2Txt)

    lEntry    := line.new(pointBTime, priceLvl667, time, priceLvl667, xloc=xloc.bar_time, color=color.lime, width=2)
    lSL       := line.new(pointBTime, priceLvl786, time, priceLvl786, xloc=xloc.bar_time, color=color.red,  width=2, style=line.style_dashed)
    lTP1      := line.new(pointBTime, priceLvl0,   time, priceLvl0,   xloc=xloc.bar_time, color=color.aqua,   width=2)
    lTP2      := line.new(pointBTime, priceLvlExt, time, priceLvlExt, xloc=xloc.bar_time, color=color.purple, width=2, style=line.style_dotted)
    lEntryTxt := label.new(bar_index, priceLvl667, "Entry " + str.tostring(priceLvl667, format.mintick), style=label.style_label_left, color=color.lime, textcolor=color.black, size=size.small)
    lSLTxt    := label.new(bar_index, priceLvl786, "Stop loss " + str.tostring(priceLvl786, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
    lTP1Txt   := label.new(bar_index, priceLvl0,   "TP1 " + str.tostring(priceLvl0, format.mintick), style=label.style_label_left, color=color.aqua, textcolor=color.black, size=size.small)
    lTP2Txt   := label.new(bar_index, priceLvlExt, "TP2 " + str.tostring(priceLvlExt, format.mintick), style=label.style_label_left, color=color.purple, textcolor=color.white, size=size.small)

if correctionStarted
    label.new(bar_index, priceLvl667, legUp ? "Buy - Entry" : "Sell - Entry", style=legUp ? label.style_label_up : label.style_label_down, color=color.lime, textcolor=color.black, size=size.small)

if tp1HitNow
    label.new(bar_index, priceLvl0, "TP1 hit", style=legUp ? label.style_label_up : label.style_label_down, color=color.aqua, textcolor=color.black, size=size.small)

if tp2HitNow
    label.new(bar_index, priceLvlExt, "TP2 hit", style=legUp ? label.style_label_up : label.style_label_down, color=color.purple, textcolor=color.white, size=size.small)

alertcondition(correctionStarted, title="Entry alert at 0.667", message="Entry point: price reached the 0.667 level")
alertcondition(slHitNow, title="Stop loss alert at 0.786", message="Stop loss breached at the 0.786 level")
alertcondition(tp1HitNow, title="TP1 alert at level 0", message="Take profit 1 reached at level 0")
alertcondition(tp2HitNow, title="TP2 alert at level -1.3", message="Take profit 2 reached at the -1.3 extension level")

// ---------------- Trend display ----------------
bgcolor(trendUp ? color.new(color.green, 92) : trendDown ? color.new(color.red, 92) : na)
plotshape(trendUp and not trendUp[1],     title="Uptrend start",   style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.tiny)
plotshape(trendDown and not trendDown[1], title="Downtrend start", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.tiny)

var label trendLabel = na
if barstate.islast
    label.delete(trendLabel)
    trendLabel := label.new(bar_index, high, trendUp ? "Trend: Up (1H)" : trendDown ? "Trend: Down (1H)" : "Trend: Neutral (1H)", style=label.style_label_left, color=trendUp ? color.green : trendDown ? color.red : color.gray, textcolor=color.white, size=size.small)
