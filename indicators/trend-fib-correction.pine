//@version=5
indicator("Trend (1H) + Swing Fib Correction Alert (5M)", shorttitle="Trend+Fib", overlay=true, max_lines_count=50, max_labels_count=50)

// ---------------- الاتجاه العام (فريم ساعة) ----------------
grpTrend   = "الاتجاه - فريم 1 ساعة"
trendTF    = input.timeframe("60", "فريم تحديد الاتجاه", group=grpTrend)
fastLen    = input.int(50, "EMA سريع", group=grpTrend)
slowLen    = input.int(200, "EMA بطيء", group=grpTrend)

[emaFast1h, emaSlow1h] = request.security(syminfo.tickerid, trendTF, [ta.ema(close, fastLen), ta.ema(close, slowLen)], lookahead=barmerge.lookahead_off)

trendUp   = emaFast1h > emaSlow1h
trendDown = emaFast1h < emaSlow1h

// ---------------- القمة والقاع (فريم 5 دقائق) ----------------
// شغّل المؤشر على شارت 5 دقائق حتى يقرأ high/low الصحيحة لهذا الفريم
grpSwing    = "القمة والقاع - فريم 5 دقائق"
pivotLeft   = input.int(5, "شموع يسار البيفوت", group=grpSwing)
pivotRight  = input.int(5, "شموع يمين البيفوت (تأكيد)", group=grpSwing)

ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastPivotHigh    = na
var int   lastPivotHighBar = na
var float lastPivotLow     = na
var int   lastPivotLowBar  = na

if not na(ph)
    lastPivotHigh    := ph
    lastPivotHighBar := bar_index - pivotRight

if not na(pl)
    lastPivotLow    := pl
    lastPivotLowBar := bar_index - pivotRight

// ---------------- فيبوناتشي ----------------
grpFib   = "مستويات فيبوناتشي"
lvl1     = input.float(1.0,   "مستوى 1",      group=grpFib)
lvl786   = input.float(0.786, "مستوى 0.786",  group=grpFib)
lvl667   = input.float(0.667, "مستوى 0.667 (حد التصحيح)", group=grpFib)
lvl0     = input.float(0.0,   "مستوى 0",      group=grpFib)
lvlExt   = input.float(-1.3,  "مستوى الامتداد -1.3", group=grpFib)

// نقطة A = آخر قمة/قاع في اتجاه الترند (تمثل level 0)
// نقطة B = القمة/القاع الأقدم قبلها (تمثل level 1)
haveLeg = not na(lastPivotHigh) and not na(lastPivotLow)

float pointA    = na
float pointB    = na
int   pointBBar = na

if haveLeg
    if trendUp and lastPivotHighBar > lastPivotLowBar
        pointA    := lastPivotHigh
        pointB    := lastPivotLow
        pointBBar := lastPivotLowBar
    else if trendDown and lastPivotLowBar > lastPivotHighBar
        pointA    := lastPivotLow
        pointB    := lastPivotHigh
        pointBBar := lastPivotHighBar

validLeg = not na(pointA) and not na(pointB)

f_priceAtLevel(a, b, l) => a + (b - a) * l

priceLvl1   = validLeg ? f_priceAtLevel(pointA, pointB, lvl1)   : na
priceLvl786 = validLeg ? f_priceAtLevel(pointA, pointB, lvl786) : na
priceLvl667 = validLeg ? f_priceAtLevel(pointA, pointB, lvl667) : na
priceLvl0   = validLeg ? f_priceAtLevel(pointA, pointB, lvl0)   : na
priceLvlExt = validLeg ? f_priceAtLevel(pointA, pointB, lvlExt) : na

// تصحيح = السعر رجع أعمق من مستوى 0.667 باتجاه معاكس للترند
corrected        = validLeg and (trendUp ? close < priceLvl667 : close > priceLvl667)
correctionStarted = corrected and not corrected[1]

// ---------------- رسم/تحديث فيبوناتشي عند عدم وجود تصحيح ----------------
var line  l1     = na
var line  l786   = na
var line  l667   = na
var line  l0     = na
var line  lExt   = na
var label lState = na

if validLeg and not corrected
    line.delete(l1)
    line.delete(l786)
    line.delete(l667)
    line.delete(l0)
    line.delete(lExt)
    label.delete(lState)

    l1   := line.new(pointBBar, priceLvl1,   bar_index, priceLvl1,   color=color.gray,   style=line.style_dashed)
    l786 := line.new(pointBBar, priceLvl786, bar_index, priceLvl786, color=color.orange)
    l667 := line.new(pointBBar, priceLvl667, bar_index, priceLvl667, color=color.red)
    l0   := line.new(pointBBar, priceLvl0,   bar_index, priceLvl0,   color=color.gray,   style=line.style_dashed)
    lExt := line.new(pointBBar, priceLvlExt, bar_index, priceLvlExt, color=color.blue,   style=line.style_dotted)

    lState := label.new(bar_index, priceLvlExt, "لا يوجد تصحيح - فيبو نشط", style=label.style_label_down, color=color.blue, textcolor=color.white, size=size.small)

if corrected
    label.delete(lState)
    lState := label.new(bar_index, trendUp ? low : high, "تنبيه: تصحيح على السعر", style=trendUp ? label.style_label_up : label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

alertcondition(correctionStarted, title="تنبيه تصحيح السعر", message="تم رصد تصحيح على السعر بعد آخر ساق في اتجاه الترند")

// ---------------- عرض الاتجاه ----------------
bgcolor(trendUp ? color.new(color.green, 92) : trendDown ? color.new(color.red, 92) : na)
plotshape(trendUp and not trendUp[1],     title="بداية ترند صاعد", style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.tiny)
plotshape(trendDown and not trendDown[1], title="بداية ترند هابط", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.tiny)

var label trendLabel = na
if barstate.islast
    label.delete(trendLabel)
    trendLabel := label.new(bar_index, high, trendUp ? "الاتجاه: صاعد (1H)" : trendDown ? "الاتجاه: هابط (1H)" : "الاتجاه: محايد (1H)", style=label.style_label_left, color=trendUp ? color.green : trendDown ? color.red : color.gray, textcolor=color.white, size=size.small)
