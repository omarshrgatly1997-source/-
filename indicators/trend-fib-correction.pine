//@version=6
indicator("omar_shrgatly - Trend+Fib+FVG", shorttitle="omar_shrgatly", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==========================================
// PART 1: TREND (1H) + SWING FIB CORRECTION (5M)
// ==========================================

// ---------------- Trend (1 hour timeframe) ----------------
grpTrend   = "Trend - 1H"
trendTF    = input.timeframe("60", "Trend timeframe", group=grpTrend)
fastLen    = input.int(50, "Fast EMA", group=grpTrend)
slowLen    = input.int(200, "Slow EMA", group=grpTrend)

[emaFast1h, emaSlow1h] = request.security(syminfo.tickerid, trendTF, [ta.ema(close, fastLen), ta.ema(close, slowLen)], lookahead=barmerge.lookahead_off)

trendUp   = emaFast1h > emaSlow1h
trendDown = emaFast1h < emaSlow1h

// ---------------- Swing high/low (5 minute timeframe) ----------------
// Run this indicator on a 5-minute chart so it reads the correct high/low for that timeframe
grpSwing    = "Swing High/Low - 5M"
pivotLeft   = input.int(5, "Pivot left bars", group=grpSwing)
pivotRight  = input.int(5, "Pivot right bars (confirmation)", group=grpSwing)
minSwingPct = input.float(0.3, "Minimum swing size %  (filters minor highs/lows)", minval=0.0, step=0.1, group=grpSwing)

ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

f_swingPct(a, b) => (na(a) or na(b) or b == 0) ? na : math.abs(a - b) / b * 100

var float lastPivotHigh    = na
var int   lastPivotHighBar = na
var float lastPivotLow     = na
var int   lastPivotLowBar  = na
var bool  brokenHigh       = false
var bool  brokenLow        = false
var int   zigDir           = 0  // 0 = none yet, 1 = last major point was a high, -1 = last major point was a low

// Only keep a pivot as the major high/low if it either extends the current
// swing further, or reverses far enough (minSwingPct) from the opposite major
// point. This filters out minor highs/lows and keeps only the main ones.
if not na(ph)
    if zigDir == 1
        if ph > lastPivotHigh
            lastPivotHigh    := ph
            lastPivotHighBar := bar_index - pivotRight
            brokenHigh       := false
    else if na(lastPivotLow) or f_swingPct(ph, lastPivotLow) >= minSwingPct
        lastPivotHigh    := ph
        lastPivotHighBar := bar_index - pivotRight
        brokenHigh       := false
        zigDir            := 1

if not na(pl)
    if zigDir == -1
        if pl < lastPivotLow
            lastPivotLow    := pl
            lastPivotLowBar := bar_index - pivotRight
            brokenLow       := false
    else if na(lastPivotHigh) or f_swingPct(lastPivotHigh, pl) >= minSwingPct
        lastPivotLow    := pl
        lastPivotLowBar := bar_index - pivotRight
        brokenLow       := false
        zigDir           := -1

// ---------------- BOS / CHoCH on structure break (pivot based) ----------------
// Break confirmed by candle close -> BOS. Break by wick only (close stays back inside) -> CHoCH.
breakUp   = not brokenHigh and not na(lastPivotHigh) and high > lastPivotHigh
breakDown = not brokenLow  and not na(lastPivotLow)  and low  < lastPivotLow

if breakUp
    brokenHigh := true
    label.new(bar_index, high, close > lastPivotHigh ? "BOS" : "CHoCH", style=label.style_label_down, color=close > lastPivotHigh ? color.green : color.orange, textcolor=color.white, size=size.small)

if breakDown
    brokenLow := true
    label.new(bar_index, low, close < lastPivotLow ? "BOS" : "CHoCH", style=label.style_label_up, color=close < lastPivotLow ? color.red : color.orange, textcolor=color.white, size=size.small)

// ---------------- Fibonacci ----------------
grpFib   = "Fibonacci Levels"
lvl1     = input.float(1.0,   "Level 1",              group=grpFib)
lvl786   = input.float(0.786, "Level 0.786 (stop loss)", group=grpFib)
lvl667   = input.float(0.667, "Level 0.667 (entry)",  group=grpFib)
lvl0     = input.float(0.0,   "Level 0",              group=grpFib)
lvlExt   = input.float(-1.3,  "Extension level -1.3", group=grpFib)

// Point A = most recent swing high/low in the trend direction (represents level 0)
// Point B = the older swing high/low before it (represents level 1)
haveLeg = not na(lastPivotHigh) and not na(lastPivotLow)

float pointA    = na
float pointB    = na
int   pointBBar = na

if haveLeg
    if trendUp and lastPivotHighBar > lastPivotLowBar
        pointA    := lastPivotHigh
        pointB    := lastPivotLow
        pointBBar := lastPivotLowBar
    else if trendDown and lastPivotLowBar > lastPivotHighBar
        pointA    := lastPivotLow
        pointB    := lastPivotHigh
        pointBBar := lastPivotHighBar

validLeg = not na(pointA) and not na(pointB)

f_priceAtLevel(a, b, l) => a + (b - a) * l

priceLvl1   = validLeg ? f_priceAtLevel(pointA, pointB, lvl1)   : na
priceLvl786 = validLeg ? f_priceAtLevel(pointA, pointB, lvl786) : na
priceLvl667 = validLeg ? f_priceAtLevel(pointA, pointB, lvl667) : na
priceLvl0   = validLeg ? f_priceAtLevel(pointA, pointB, lvl0)   : na
priceLvlExt = validLeg ? f_priceAtLevel(pointA, pointB, lvlExt) : na

// Correction = price pulled back past the 0.667 level against the trend -> this is the entry point
corrected        = validLeg and (trendUp ? close < priceLvl667 : close > priceLvl667)
correctionStarted = corrected and not corrected[1]

// Stop loss = price breaks past the 0.786 level (deeper than the entry)
slHit     = validLeg and (trendUp ? close < priceLvl786 : close > priceLvl786)
slHitNow  = slHit and not slHit[1]

// TP1 = level 0, TP2 = extension level -1.3 (both in the trend's favorable direction)
tp1Hit    = validLeg and (trendUp ? close > priceLvl0   : close < priceLvl0)
tp1HitNow = tp1Hit and not tp1Hit[1]
tp2Hit    = validLeg and (trendUp ? close > priceLvlExt : close < priceLvlExt)
tp2HitNow = tp2Hit and not tp2Hit[1]

// ---------------- 5M trade stats box ----------------
// One "trade" = one entry at 0.667. It stays open until TP2 or SL closes it,
// or a new swing leg forms and resets tracking. A loss only counts if SL is
// hit before TP1 was ever reached on that trade.
var int  totalTrades = 0
var int  tp1Count    = 0
var int  tp2Count    = 0
var int  lossCount   = 0
var bool tradeOpen   = false
var bool tp1Achieved = false

newLeg = validLeg and (na(pointBBar[1]) or pointBBar != pointBBar[1])

if newLeg
    tradeOpen   := false
    tp1Achieved := false

if correctionStarted and not tradeOpen
    tradeOpen   := true
    totalTrades += 1

if tradeOpen and tp1HitNow and not tp1Achieved
    tp1Achieved := true
    tp1Count    += 1

if tradeOpen and tp2HitNow
    tp2Count  += 1
    tradeOpen := false

if tradeOpen and slHitNow
    if not tp1Achieved
        lossCount += 1
    tradeOpen := false

resolvedTrades = tp1Count + lossCount
winRateTxt     = resolvedTrades > 0 ? str.tostring(float(tp1Count) / resolvedTrades * 100, "#.#") + "%" : "—"

var table statsBox = table.new(position.top_right, 2, 6, border_width=1, border_color=color.gray, frame_color=color.gray, frame_width=1)

if barstate.islast
    table.cell(statsBox, 0, 0, "5M Stats",     text_color=color.white, bgcolor=color.new(color.blue, 30),  text_size=size.small)
    table.cell(statsBox, 1, 0, "",              text_color=color.white, bgcolor=color.new(color.blue, 30),  text_size=size.small)
    table.cell(statsBox, 0, 1, "Entries",       text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 1, str.tostring(totalTrades), text_color=color.white,  bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 2, "TP1 hits",      text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 2, str.tostring(tp1Count),    text_color=color.aqua,   bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 3, "TP2 hits",      text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 3, str.tostring(tp2Count),    text_color=color.purple, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 4, "Losses (SL)",   text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 4, str.tostring(lossCount),   text_color=color.red,    bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 5, "Win rate",      text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 5, winRateTxt,      text_color=color.lime,  bgcolor=color.new(color.black, 40), text_size=size.small)

// ---------------- Draw/update Fibonacci while no correction has happened ----------------
var line  l1     = na
var label lState = na

if validLeg and not corrected
    line.delete(l1)
    label.delete(lState)

    l1 := line.new(pointBBar, priceLvl1, bar_index, priceLvl1, color=color.gray, style=line.style_dashed)

    lState := label.new(bar_index, priceLvl1, "No correction - Fib active", style=label.style_label_down, color=color.blue, textcolor=color.white, size=size.small)

if corrected
    label.delete(lState)
    lState := label.new(bar_index, trendUp ? low : high, "Alert: price correction", style=trendUp ? label.style_label_up : label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// ---------------- Entry (0.667), stop loss (0.786), TP1 (0) and TP2 (-1.3) ----------------
var line  lEntry    = na
var line  lSL       = na
var line  lTP1      = na
var line  lTP2      = na
var label lEntryTxt = na
var label lSLTxt    = na
var label lTP1Txt   = na
var label lTP2Txt   = na

if validLeg
    line.delete(lEntry)
    line.delete(lSL)
    line.delete(lTP1)
    line.delete(lTP2)
    label.delete(lEntryTxt)
    label.delete(lSLTxt)
    label.delete(lTP1Txt)
    label.delete(lTP2Txt)

    lEntry    := line.new(pointBBar, priceLvl667, bar_index, priceLvl667, color=color.lime, width=2)
    lSL       := line.new(pointBBar, priceLvl786, bar_index, priceLvl786, color=color.red,  width=2, style=line.style_dashed)
    lTP1      := line.new(pointBBar, priceLvl0,   bar_index, priceLvl0,   color=color.aqua,   width=2)
    lTP2      := line.new(pointBBar, priceLvlExt, bar_index, priceLvlExt, color=color.purple, width=2, style=line.style_dotted)
    lEntryTxt := label.new(bar_index, priceLvl667, "Entry " + str.tostring(priceLvl667, format.mintick), style=label.style_label_left, color=color.lime, textcolor=color.black, size=size.small)
    lSLTxt    := label.new(bar_index, priceLvl786, "Stop loss " + str.tostring(priceLvl786, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
    lTP1Txt   := label.new(bar_index, priceLvl0,   "TP1 " + str.tostring(priceLvl0, format.mintick), style=label.style_label_left, color=color.aqua, textcolor=color.black, size=size.small)
    lTP2Txt   := label.new(bar_index, priceLvlExt, "TP2 " + str.tostring(priceLvlExt, format.mintick), style=label.style_label_left, color=color.purple, textcolor=color.white, size=size.small)

if correctionStarted
    label.new(bar_index, priceLvl667, trendUp ? "Buy - Entry" : "Sell - Entry", style=trendUp ? label.style_label_up : label.style_label_down, color=color.lime, textcolor=color.black, size=size.small)

if tp1HitNow
    label.new(bar_index, priceLvl0, "TP1 hit", style=trendUp ? label.style_label_up : label.style_label_down, color=color.aqua, textcolor=color.black, size=size.small)

if tp2HitNow
    label.new(bar_index, priceLvlExt, "TP2 hit", style=trendUp ? label.style_label_up : label.style_label_down, color=color.purple, textcolor=color.white, size=size.small)

alertcondition(correctionStarted, title="Entry alert at 0.667", message="Entry point: price reached the 0.667 level")
alertcondition(slHitNow, title="Stop loss alert at 0.786", message="Stop loss breached at the 0.786 level")
alertcondition(tp1HitNow, title="TP1 alert at level 0", message="Take profit 1 reached at level 0")
alertcondition(tp2HitNow, title="TP2 alert at level -1.3", message="Take profit 2 reached at the -1.3 extension level")

// ---------------- Trend display ----------------
bgcolor(trendUp ? color.new(color.green, 92) : trendDown ? color.new(color.red, 92) : na)
plotshape(trendUp and not trendUp[1],     title="Uptrend start",   style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.tiny)
plotshape(trendDown and not trendDown[1], title="Downtrend start", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.tiny)

var label trendLabel = na
if barstate.islast
    label.delete(trendLabel)
    trendLabel := label.new(bar_index, high, trendUp ? "Trend: Up (1H)" : trendDown ? "Trend: Down (1H)" : "Trend: Neutral (1H)", style=label.style_label_left, color=trendUp ? color.green : trendDown ? color.red : color.gray, textcolor=color.white, size=size.small)

// ==========================================
// PART 2: FVG + MARKET STRUCTURE (BOS / SWEEP)
// ==========================================

// ==========================================
// 🔹 1. FVG SETTINGS
// ==========================================
showBullFVG = input.bool(true, title="Bullish Imbalance", group="Imbalances", inline="fvgbull")
aantBullFVG = input.int(10, title="#", group="Imbalances", inline="fvgbull")
colorBullFVG = input.color(color.new(color.aqua,80),title="BG", group="Imbalances", inline="fvgbull")
lineBullFVG = input.color(color.new(color.aqua,90),title="Line", group="Imbalances", inline="fvgbull")

showBearFVG = input.bool(true, title="Bearish Imbalance", group="Imbalances", inline="fvgbear")
aantbearFVG = input.int(10, title="#", group="Imbalances", inline="fvgbear")
colorbearFVG = input.color(color.new(color.orange,80),title="BG", group="Imbalances", inline="fvgbear")
linebearFVG = input.color(color.new(color.orange,90),title="Line", group="Imbalances", inline="fvgbear")

// ==========================================
// 🔹 2. STRUCTURE & BOS/SWEEP SETTINGS
// ==========================================
grp_struct = "Market Structure"
showStructure = input.bool(true, "Show Connection Lines", group=grp_struct)
colStructBull = input.color(color.green, "Expansion Up (HH)", group=grp_struct)
colStructBear = input.color(color.red, "Expansion Down (LL)", group=grp_struct)
colStructInt  = input.color(color.gray, "Internal (LH/HL)", group=grp_struct)
widthStruct   = input.int(2, "Connection Width", group=grp_struct)

grp_break = "Breaks & Sweeps"
showBreaks    = input.bool(true, "Show BOS/Sweep Lines", group=grp_break)
colBOS        = input.color(color.green, "BOS (Break) Color", group=grp_break)
colSweep      = input.color(color.gray, "Sweep (Fakeout) Color", group=grp_break)
lblSize       = input.string(size.tiny, "Label Size", options=[size.tiny, size.small, size.normal], group=grp_break)

// ==========================================
// 🔹 3. TYPES & ARRAYS
// ==========================================
type FVG
    box id
    bool isMitigated
    float top
    float bottom
    int createdIndex

var array<FVG> bullList = array.new<FVG>()
var array<FVG> bearList = array.new<FVG>()

// ==========================================
// 🔹 4. LOGICA VARIABELEN
// ==========================================
bullFVG = low > high[2]
bearFVG = low[2] > high

// State tracking voor structuur
var int mode = 0
var float tempPeakPrice = na
var int tempPeakTime = 0
var float lastConfirmedPrice = na
var int lastConfirmedTime = 0

// State tracking voor BOS/Sweeps (en voor kleuring van de legs)
var float activeOldHighPrice = na
var bool activeOldHighBroken = true

var float activeOldLowPrice = na
var bool activeOldLowBroken = true

// Variabelen om de 'Fakeout' te detecteren (volgende candle check)
var line lastHighLine = na
var label lastHighLabel = na
var bool monitorHighBreak = false
var float breakHighCandleLow = na

var line lastLowLine = na
var label lastLowLabel = na
var bool monitorLowBreak = false
var float breakLowCandleHigh = na

// ==========================================
// 🔹 5. MAIN LOGIC LOOP
// ==========================================

// --- A. STRUCTURE UPDATE LOGIC ---
if mode == 1 // Zoeken naar High
    if high > tempPeakPrice
        tempPeakPrice := high
        tempPeakTime := time

    if bearFVG
        // Bevestig de High (We komen van Low -> High)
        if showStructure
            // Bepaal kleur: Is deze High hoger dan de vorige Active Old High?
            color legColor = colStructInt
            if not na(activeOldHighPrice)
                if tempPeakPrice > activeOldHighPrice
                    legColor := colStructBull // HH = Expansion Up
                else
                    legColor := colStructInt // LH = Internal
            else
                legColor := colStructInt // Eerste lijn

            line.new(lastConfirmedTime, lastConfirmedPrice, tempPeakTime, tempPeakPrice, xloc=xloc.bar_time, color=legColor, width=widthStruct)

        // Update Active Old High
        activeOldHighPrice := tempPeakPrice
        activeOldHighBroken := false // Reset break status

        // Update pointers
        lastConfirmedPrice := tempPeakPrice
        lastConfirmedTime := tempPeakTime
        mode := -1
        tempPeakPrice := low
        tempPeakTime := time

else if mode == -1 // Zoeken naar Low
    if low < tempPeakPrice
        tempPeakPrice := low
        tempPeakTime := time

    if bullFVG
        // Bevestig de Low (We komen van High -> Low)
        if showStructure
            // Bepaal kleur: Is deze Low lager dan de vorige Active Old Low?
            color legColor = colStructInt
            if not na(activeOldLowPrice)
                if tempPeakPrice < activeOldLowPrice
                    legColor := colStructBear // LL = Expansion Down
                else
                    legColor := colStructInt // HL = Internal
            else
                legColor := colStructInt

            line.new(lastConfirmedTime, lastConfirmedPrice, tempPeakTime, tempPeakPrice, xloc=xloc.bar_time, color=legColor, width=widthStruct)

        // Update Active Old Low
        activeOldLowPrice := tempPeakPrice
        activeOldLowBroken := false // Reset break status

        // Update pointers
        lastConfirmedPrice := tempPeakPrice
        lastConfirmedTime := tempPeakTime
        mode := 1
        tempPeakPrice := high
        tempPeakTime := time

else if mode == 0 // Start up
    if bullFVG
        mode := 1
        tempPeakPrice := high
        tempPeakTime := time
        lastConfirmedPrice := low[2]
        lastConfirmedTime := time[2]
        activeOldLowPrice := low[2]
    else if bearFVG
        mode := -1
        tempPeakPrice := low
        tempPeakTime := time
        lastConfirmedPrice := high[2]
        lastConfirmedTime := time[2]
        activeOldHighPrice := high[2]

// --- B. BREAK & SWEEP DETECTION LOGIC ---

if showBreaks
    // 1. Check BULLISH Break/Sweep
    if not activeOldHighBroken and not na(activeOldHighPrice)
        if high > activeOldHighPrice
            if close <= activeOldHighPrice // Wick Sweep
                lastHighLine := line.new(tempPeakTime, activeOldHighPrice, time, activeOldHighPrice, xloc=xloc.bar_time, color=colSweep, style=line.style_dashed)
                lastHighLabel := label.new(time, activeOldHighPrice, "Sweep", xloc=xloc.bar_time, color=color(na), style=label.style_label_down, textcolor=colSweep, size=lblSize)
                activeOldHighBroken := true
                monitorHighBreak := false
            else // Potential Break
                lastHighLine := line.new(tempPeakTime, activeOldHighPrice, time, activeOldHighPrice, xloc=xloc.bar_time, color=colBOS, style=line.style_solid)
                lastHighLabel := label.new(time, activeOldHighPrice, "BOS", xloc=xloc.bar_time, color=color(na), style=label.style_label_down, textcolor=colBOS, size=lblSize)
                activeOldHighBroken := true
                monitorHighBreak := true
                breakHighCandleLow := low

    // 1b. Monitor Bullish Fakeout
    else if monitorHighBreak
        if close < breakHighCandleLow
            line.set_style(lastHighLine, line.style_dashed)
            line.set_color(lastHighLine, colSweep)
            label.set_text(lastHighLabel, "Sweep")
            label.set_textcolor(lastHighLabel, colSweep)
        monitorHighBreak := false

    // 2. Check BEARISH Break/Sweep
    if not activeOldLowBroken and not na(activeOldLowPrice)
        if low < activeOldLowPrice
            if close >= activeOldLowPrice // Wick Sweep
                lastLowLine := line.new(tempPeakTime, activeOldLowPrice, time, activeOldLowPrice, xloc=xloc.bar_time, color=colSweep, style=line.style_dashed)
                lastLowLabel := label.new(time, activeOldLowPrice, "Sweep", xloc=xloc.bar_time, color=color(na), style=label.style_label_up, textcolor=colSweep, size=lblSize)
                activeOldLowBroken := true
                monitorLowBreak := false
            else // Potential Break
                lastLowLine := line.new(tempPeakTime, activeOldLowPrice, time, activeOldLowPrice, xloc=xloc.bar_time, color=colBOS, style=line.style_solid)
                lastLowLabel := label.new(time, activeOldLowPrice, "BOS", xloc=xloc.bar_time, color=color(na), style=label.style_label_up, textcolor=colBOS, size=lblSize)
                activeOldLowBroken := true
                monitorLowBreak := true
                breakLowCandleHigh := high

    // 2b. Monitor Bearish Fakeout
    else if monitorLowBreak
        if close > breakLowCandleHigh
            line.set_style(lastLowLine, line.style_dashed)
            line.set_color(lastLowLine, colSweep)
            label.set_text(lastLowLabel, "Sweep")
            label.set_textcolor(lastLowLabel, colSweep)
        monitorLowBreak := false

// ==========================================
// 🔹 6. FVG BOX UPDATE (Original Logic)
// ==========================================
method update_fvg_list(array<FVG> list, bool isBull, int limit, color bgColor, color lnColor) =>
    if (isBull ? bullFVG : bearFVG)
        float _top = isBull ? low : low[2]
        float _btm = isBull ? high[2] : high
        box newBox = box.new(time[2], _top, time + timeframe.in_seconds(timeframe.period)*1000, _btm, xloc=xloc.bar_time, bgcolor=bgColor, border_color=lnColor)
        FVG newEntry = FVG.new(newBox, false, _top, _btm, bar_index)
        array.push(list, newEntry)

    if array.size(list) > 0
        int duration = timeframe.in_seconds(timeframe.period) * 1000
        for i = 0 to array.size(list) - 1
            FVG item = array.get(list, i)
            if not item.isMitigated
                if bar_index > item.createdIndex
                    bool hit = isBull ? (low <= item.top) : (high >= item.bottom)
                    if hit
                        item.isMitigated := true
                        box.set_right(item.id, time)
                    else
                        box.set_right(item.id, time + duration)
                else
                    box.set_right(item.id, time + duration)

    while array.size(list) > limit
        FVG oldItem = array.shift(list)
        box.delete(oldItem.id)

if showBullFVG
    update_fvg_list(bullList, true, aantBullFVG, colorBullFVG, lineBullFVG)
if showBearFVG
    update_fvg_list(bearList, false, aantbearFVG, colorbearFVG, linebearFVG)
