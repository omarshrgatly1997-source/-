//@version=5
indicator("Trend (1H) + Swing Fib Correction Alert (5M)", shorttitle="Trend+Fib", overlay=true, max_lines_count=50, max_labels_count=50)

// ---------------- Trend (1 hour timeframe) ----------------
grpTrend   = "Trend - 1H"
trendTF    = input.timeframe("60", "Trend timeframe", group=grpTrend)
fastLen    = input.int(50, "Fast EMA", group=grpTrend)
slowLen    = input.int(200, "Slow EMA", group=grpTrend)

[emaFast1h, emaSlow1h] = request.security(syminfo.tickerid, trendTF, [ta.ema(close, fastLen), ta.ema(close, slowLen)], lookahead=barmerge.lookahead_off)

trendUp   = emaFast1h > emaSlow1h
trendDown = emaFast1h < emaSlow1h

// ---------------- Swing high/low (5 minute timeframe) ----------------
// Run this indicator on a 5-minute chart so it reads the correct high/low for that timeframe
grpSwing    = "Swing High/Low - 5M"
pivotLeft   = input.int(5, "Pivot left bars", group=grpSwing)
pivotRight  = input.int(5, "Pivot right bars (confirmation)", group=grpSwing)

ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastPivotHigh    = na
var int   lastPivotHighBar = na
var float lastPivotLow     = na
var int   lastPivotLowBar  = na
var bool  brokenHigh       = false
var bool  brokenLow        = false

if not na(ph)
    lastPivotHigh    := ph
    lastPivotHighBar := bar_index - pivotRight
    brokenHigh       := false

if not na(pl)
    lastPivotLow    := pl
    lastPivotLowBar := bar_index - pivotRight
    brokenLow       := false

// ---------------- BOS / CHoCH on structure break ----------------
// Break confirmed by candle close -> BOS. Break by wick only (close stays back inside) -> CHoCH.
breakUp   = not brokenHigh and not na(lastPivotHigh) and high > lastPivotHigh
breakDown = not brokenLow  and not na(lastPivotLow)  and low  < lastPivotLow

if breakUp
    brokenHigh := true
    label.new(bar_index, high, close > lastPivotHigh ? "BOS" : "CHoCH", style=label.style_label_down, color=close > lastPivotHigh ? color.green : color.orange, textcolor=color.white, size=size.small)

if breakDown
    brokenLow := true
    label.new(bar_index, low, close < lastPivotLow ? "BOS" : "CHoCH", style=label.style_label_up, color=close < lastPivotLow ? color.red : color.orange, textcolor=color.white, size=size.small)

// ---------------- Fibonacci ----------------
grpFib   = "Fibonacci Levels"
lvl1     = input.float(1.0,   "Level 1",              group=grpFib)
lvl786   = input.float(0.786, "Level 0.786 (stop loss)", group=grpFib)
lvl667   = input.float(0.667, "Level 0.667 (entry)",  group=grpFib)
lvl0     = input.float(0.0,   "Level 0",              group=grpFib)
lvlExt   = input.float(-1.3,  "Extension level -1.3", group=grpFib)

// Point A = most recent swing high/low in the trend direction (represents level 0)
// Point B = the older swing high/low before it (represents level 1)
haveLeg = not na(lastPivotHigh) and not na(lastPivotLow)

float pointA    = na
float pointB    = na
int   pointBBar = na

if haveLeg
    if trendUp and lastPivotHighBar > lastPivotLowBar
        pointA    := lastPivotHigh
        pointB    := lastPivotLow
        pointBBar := lastPivotLowBar
    else if trendDown and lastPivotLowBar > lastPivotHighBar
        pointA    := lastPivotLow
        pointB    := lastPivotHigh
        pointBBar := lastPivotHighBar

validLeg = not na(pointA) and not na(pointB)

f_priceAtLevel(a, b, l) => a + (b - a) * l

priceLvl1   = validLeg ? f_priceAtLevel(pointA, pointB, lvl1)   : na
priceLvl786 = validLeg ? f_priceAtLevel(pointA, pointB, lvl786) : na
priceLvl667 = validLeg ? f_priceAtLevel(pointA, pointB, lvl667) : na
priceLvl0   = validLeg ? f_priceAtLevel(pointA, pointB, lvl0)   : na
priceLvlExt = validLeg ? f_priceAtLevel(pointA, pointB, lvlExt) : na

// Correction = price pulled back past the 0.667 level against the trend -> this is the entry point
corrected        = validLeg and (trendUp ? close < priceLvl667 : close > priceLvl667)
correctionStarted = corrected and not corrected[1]

// Stop loss = price breaks past the 0.786 level (deeper than the entry)
slHit     = validLeg and (trendUp ? close < priceLvl786 : close > priceLvl786)
slHitNow  = slHit and not slHit[1]

// TP1 = level 0, TP2 = extension level -1.3 (both in the trend's favorable direction)
tp1Hit    = validLeg and (trendUp ? close > priceLvl0   : close < priceLvl0)
tp1HitNow = tp1Hit and not tp1Hit[1]
tp2Hit    = validLeg and (trendUp ? close > priceLvlExt : close < priceLvlExt)
tp2HitNow = tp2Hit and not tp2Hit[1]

// ---------------- Draw/update Fibonacci while no correction has happened ----------------
var line  l1     = na
var label lState = na

if validLeg and not corrected
    line.delete(l1)
    label.delete(lState)

    l1 := line.new(pointBBar, priceLvl1, bar_index, priceLvl1, color=color.gray, style=line.style_dashed)

    lState := label.new(bar_index, priceLvl1, "No correction - Fib active", style=label.style_label_down, color=color.blue, textcolor=color.white, size=size.small)

if corrected
    label.delete(lState)
    lState := label.new(bar_index, trendUp ? low : high, "Alert: price correction", style=trendUp ? label.style_label_up : label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// ---------------- Entry (0.667), stop loss (0.786), TP1 (0) and TP2 (-1.3) ----------------
var line  lEntry    = na
var line  lSL       = na
var line  lTP1      = na
var line  lTP2      = na
var label lEntryTxt = na
var label lSLTxt    = na
var label lTP1Txt   = na
var label lTP2Txt   = na

if validLeg
    line.delete(lEntry)
    line.delete(lSL)
    line.delete(lTP1)
    line.delete(lTP2)
    label.delete(lEntryTxt)
    label.delete(lSLTxt)
    label.delete(lTP1Txt)
    label.delete(lTP2Txt)

    lEntry    := line.new(pointBBar, priceLvl667, bar_index, priceLvl667, color=color.lime, width=2)
    lSL       := line.new(pointBBar, priceLvl786, bar_index, priceLvl786, color=color.red,  width=2, style=line.style_dashed)
    lTP1      := line.new(pointBBar, priceLvl0,   bar_index, priceLvl0,   color=color.aqua,   width=2)
    lTP2      := line.new(pointBBar, priceLvlExt, bar_index, priceLvlExt, color=color.purple, width=2, style=line.style_dotted)
    lEntryTxt := label.new(bar_index, priceLvl667, "Entry " + str.tostring(priceLvl667, format.mintick), style=label.style_label_left, color=color.lime, textcolor=color.black, size=size.small)
    lSLTxt    := label.new(bar_index, priceLvl786, "Stop loss " + str.tostring(priceLvl786, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
    lTP1Txt   := label.new(bar_index, priceLvl0,   "TP1 " + str.tostring(priceLvl0, format.mintick), style=label.style_label_left, color=color.aqua, textcolor=color.black, size=size.small)
    lTP2Txt   := label.new(bar_index, priceLvlExt, "TP2 " + str.tostring(priceLvlExt, format.mintick), style=label.style_label_left, color=color.purple, textcolor=color.white, size=size.small)

if correctionStarted
    label.new(bar_index, priceLvl667, trendUp ? "Buy - Entry" : "Sell - Entry", style=trendUp ? label.style_label_up : label.style_label_down, color=color.lime, textcolor=color.black, size=size.small)

if tp1HitNow
    label.new(bar_index, priceLvl0, "TP1 hit", style=trendUp ? label.style_label_up : label.style_label_down, color=color.aqua, textcolor=color.black, size=size.small)

if tp2HitNow
    label.new(bar_index, priceLvlExt, "TP2 hit", style=trendUp ? label.style_label_up : label.style_label_down, color=color.purple, textcolor=color.white, size=size.small)

alertcondition(correctionStarted, title="Entry alert at 0.667", message="Entry point: price reached the 0.667 level")
alertcondition(slHitNow, title="Stop loss alert at 0.786", message="Stop loss breached at the 0.786 level")
alertcondition(tp1HitNow, title="TP1 alert at level 0", message="Take profit 1 reached at level 0")
alertcondition(tp2HitNow, title="TP2 alert at level -1.3", message="Take profit 2 reached at the -1.3 extension level")

// ---------------- Trend display ----------------
bgcolor(trendUp ? color.new(color.green, 92) : trendDown ? color.new(color.red, 92) : na)
plotshape(trendUp and not trendUp[1],     title="Uptrend start",   style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.tiny)
plotshape(trendDown and not trendDown[1], title="Downtrend start", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.tiny)

var label trendLabel = na
if barstate.islast
    label.delete(trendLabel)
    trendLabel := label.new(bar_index, high, trendUp ? "Trend: Up (1H)" : trendDown ? "Trend: Down (1H)" : "Trend: Neutral (1H)", style=label.style_label_left, color=trendUp ? color.green : trendDown ? color.red : color.gray, textcolor=color.white, size=size.small)
