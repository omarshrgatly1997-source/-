//@version=6
indicator("TB 5.1 - IRL -> ERL", overlay=true, max_lines_count=500, max_labels_count=200)

// ==========================================
// MARKET STRUCTURE SETTINGS
// ==========================================
grp_struct = "Market Structure"
showStructure = input.bool(true, "Show Connection Lines", group=grp_struct)
colStructBull = input.color(color.green, "Expansion Up (HH)", group=grp_struct)
colStructBear = input.color(color.red, "Expansion Down (LL)", group=grp_struct)
colStructInt  = input.color(color.gray, "Internal (LH/HL)", group=grp_struct)
widthStruct   = input.int(2, "Connection Width", group=grp_struct)
minBarsBetweenSwings = input.int(20, "Minimum Candles Between Swing Points", minval=1, group=grp_struct)
minMovePercent = input.float(0.3, "Minimum Move % Between Swing Points", minval=0.0, step=0.05, group=grp_struct)

grp_break = "Breaks (BOS / Touch)"
showBreakLines = input.bool(true, "Show Level Line From Each High/Low", group=grp_break)
colBOS         = input.color(color.white, "BOS Color (body closed through)", group=grp_break)
colTouch       = input.color(color.blue,  "Touch Color (wick only, level stays active)", group=grp_break)

grp_fib = "Fibonacci & Trade"
lvl1     = input.float(1.0,   "Level 1",                    group=grp_fib)
lvl786   = input.float(0.786, "Level 0.786 (stop loss)",     group=grp_fib)
lvl667   = input.float(0.667, "Level 0.667 (entry)",         group=grp_fib)
lvl0     = input.float(0.0,   "Level 0",                     group=grp_fib)
lvlExt   = input.float(-1.3,  "Extension level -1.3 (TP2)",  group=grp_fib)

// ==========================================
// SWING HIGH/LOW CONFIRMATION TRIGGER (3-candle imbalance)
// ==========================================
bullFVG = low > high[2]
bearFVG = low[2] > high

// A candidate swing point only counts if it moved far enough (%) from the last confirmed point -- filters out minor noise
f_bigEnoughMove(newPrice, refPrice) => not na(refPrice) and math.abs(newPrice - refPrice) / refPrice * 100 >= minMovePercent

// State tracking for structure
var int mode = 0
var float tempPeakPrice = na
var int tempPeakTime = 0
var float lastConfirmedPrice = na
var int lastConfirmedTime = 0
var int lastConfirmedBarIndex = 0

var float activeOldHighPrice = na
var int   activeOldHighTime  = na
var bool  highBroken         = true
var line  lineActiveHigh     = na

var float activeOldLowPrice = na
var int   activeOldLowTime  = na
var bool  lowBroken         = true
var line  lineActiveLow     = na

// State for the Fibonacci leg built from each newly confirmed high/low
var float pointA     = na
var float pointB     = na
var int   pointBTime = na
var bool  legUp      = false
var bool  validLeg   = false

// Trade stats
var int  totalTrades = 0
var int  tp1Count    = 0
var int  tp2Count    = 0
var int  lossCount   = 0
var bool tradeOpen   = false
var bool tp1Achieved = false

// Event markers for the current trade only -- cleared whenever a new leg starts
var label lBuySellEntry = na
var label lTp1Hit       = na
var label lTp2Hit       = na

// ==========================================
// STRUCTURE UPDATE LOGIC (finds & confirms the swing high / swing low)
// ==========================================
if mode == 1 // Searching for a High
    if high > tempPeakPrice
        tempPeakPrice := high
        tempPeakTime := time

    if bearFVG and (bar_index - lastConfirmedBarIndex) >= minBarsBetweenSwings and f_bigEnoughMove(tempPeakPrice, lastConfirmedPrice)
        // Confirm the High (we came from Low -> High)
        bool isExpansion = not na(activeOldHighPrice) and tempPeakPrice > activeOldHighPrice

        if showStructure
            color legColor = isExpansion ? colStructBull : colStructInt
            line.new(lastConfirmedTime, lastConfirmedPrice, tempPeakTime, tempPeakPrice, xloc=xloc.bar_time, color=legColor, width=widthStruct)

        activeOldHighPrice := tempPeakPrice
        activeOldHighTime  := tempPeakTime
        highBroken         := false

        // New leg: from the old confirmed Low (pointB) to this new High (pointA)
        // Expansion Up (HH, green line) only -- an Internal High (LH, gray line) does not start a new leg/trade
        if isExpansion
            pointA      := tempPeakPrice
            pointB      := lastConfirmedPrice
            pointBTime  := lastConfirmedTime
            legUp       := true
            validLeg    := not na(pointB)
            tradeOpen   := false
            tp1Achieved := false
            label.delete(lBuySellEntry)
            label.delete(lTp1Hit)
            label.delete(lTp2Hit)

        lastConfirmedPrice := tempPeakPrice
        lastConfirmedTime := tempPeakTime
        lastConfirmedBarIndex := bar_index
        mode := -1
        tempPeakPrice := low
        tempPeakTime := time

else if mode == -1 // Searching for a Low
    if low < tempPeakPrice
        tempPeakPrice := low
        tempPeakTime := time

    if bullFVG and (bar_index - lastConfirmedBarIndex) >= minBarsBetweenSwings and f_bigEnoughMove(tempPeakPrice, lastConfirmedPrice)
        // Confirm the Low (we came from High -> Low)
        bool isExpansion = not na(activeOldLowPrice) and tempPeakPrice < activeOldLowPrice

        if showStructure
            color legColor = isExpansion ? colStructBear : colStructInt
            line.new(lastConfirmedTime, lastConfirmedPrice, tempPeakTime, tempPeakPrice, xloc=xloc.bar_time, color=legColor, width=widthStruct)

        activeOldLowPrice := tempPeakPrice
        activeOldLowTime  := tempPeakTime
        lowBroken         := false

        // New leg: from the old confirmed High (pointB) to this new Low (pointA)
        // Expansion Down (LL, red line) only -- an Internal Low (HL, gray line) does not start a new leg/trade
        if isExpansion
            pointA      := tempPeakPrice
            pointB      := lastConfirmedPrice
            pointBTime  := lastConfirmedTime
            legUp       := false
            validLeg    := not na(pointB)
            tradeOpen   := false
            tp1Achieved := false
            label.delete(lBuySellEntry)
            label.delete(lTp1Hit)
            label.delete(lTp2Hit)

        lastConfirmedPrice := tempPeakPrice
        lastConfirmedTime := tempPeakTime
        lastConfirmedBarIndex := bar_index
        mode := 1
        tempPeakPrice := high
        tempPeakTime := time

else if mode == 0 // Start up
    if bullFVG
        mode := 1
        tempPeakPrice := high
        tempPeakTime := time
        lastConfirmedPrice := low[2]
        lastConfirmedTime := time[2]
        lastConfirmedBarIndex := bar_index - 2
        activeOldLowPrice := low[2]
        activeOldLowTime  := time[2]
        lowBroken         := false
    else if bearFVG
        mode := -1
        tempPeakPrice := low
        tempPeakTime := time
        lastConfirmedPrice := high[2]
        lastConfirmedTime := time[2]
        lastConfirmedBarIndex := bar_index - 2
        activeOldHighPrice := high[2]
        activeOldHighTime  := time[2]
        highBroken         := false

// ==========================================
// BREAK DETECTION (BOS / Touch) on the active (unbroken) high/low
// ==========================================
// BOS   = the breaking candle's body (close) closed through the level -> permanent white line, level marked broken.
// Touch = only the wick reached through it, the close stayed back inside -> permanent blue line, level stays active.
// The permanent line is a brand new, independent line object (not the reused
// "active" line variable) so it stays on the chart forever -- it never gets
// deleted when the next high/low cycle starts drawing its own preview line.
if not na(activeOldHighPrice) and not highBroken and high > activeOldHighPrice
    if close > activeOldHighPrice
        highBroken := true
        line.delete(lineActiveHigh)
        line.new(activeOldHighTime, activeOldHighPrice, time, activeOldHighPrice, xloc=xloc.bar_time, color=colBOS, style=line.style_solid, width=2)
    else
        line.new(activeOldHighTime, activeOldHighPrice, time, activeOldHighPrice, xloc=xloc.bar_time, color=colTouch, style=line.style_solid, width=2)

if not na(activeOldLowPrice) and not lowBroken and low < activeOldLowPrice
    if close < activeOldLowPrice
        lowBroken := true
        line.delete(lineActiveLow)
        line.new(activeOldLowTime, activeOldLowPrice, time, activeOldLowPrice, xloc=xloc.bar_time, color=colBOS, style=line.style_solid, width=2)
    else
        line.new(activeOldLowTime, activeOldLowPrice, time, activeOldLowPrice, xloc=xloc.bar_time, color=colTouch, style=line.style_solid, width=2)

if showBreakLines
    if not na(activeOldHighPrice) and not highBroken
        line.delete(lineActiveHigh)
        lineActiveHigh := line.new(activeOldHighTime, activeOldHighPrice, time, activeOldHighPrice, xloc=xloc.bar_time, color=colStructInt, style=line.style_dashed, width=1)

    if not na(activeOldLowPrice) and not lowBroken
        line.delete(lineActiveLow)
        lineActiveLow := line.new(activeOldLowTime, activeOldLowPrice, time, activeOldLowPrice, xloc=xloc.bar_time, color=colStructInt, style=line.style_dashed, width=1)

// ==========================================
// FIBONACCI ON EACH CONFIRMED HIGH/LOW -> ENTRY / SL / TP1 / TP2
// ==========================================
// pointA = the point just confirmed (level 0), pointB = the one before it (level 1).
// legUp = true means pointA is a High (a Buy pullback setup); false means pointA
// is a Low (a Sell pullback setup).
f_priceAtLevel(a, b, l) => a + (b - a) * l

priceLvl1   = validLeg ? f_priceAtLevel(pointA, pointB, lvl1)   : na
priceLvl786 = validLeg ? f_priceAtLevel(pointA, pointB, lvl786) : na
priceLvl667 = validLeg ? f_priceAtLevel(pointA, pointB, lvl667) : na
priceLvl0   = validLeg ? f_priceAtLevel(pointA, pointB, lvl0)   : na
priceLvlExt = validLeg ? f_priceAtLevel(pointA, pointB, lvlExt) : na

// Correction = price pulled back past 0.667 against the leg -> this is the entry point
corrected        = validLeg and (legUp ? close < priceLvl667 : close > priceLvl667)
correctionStarted = corrected and not corrected[1]

// Stop loss = price breaks past 0.786 (deeper than the entry)
slHit    = validLeg and (legUp ? close < priceLvl786 : close > priceLvl786)
slHitNow = slHit and not slHit[1]

// TP1 = level 0, TP2 = extension level -1.3 (both in the leg's favorable direction)
tp1Hit    = validLeg and (legUp ? close > priceLvl0   : close < priceLvl0)
tp1HitNow = tp1Hit and not tp1Hit[1]
tp2Hit    = validLeg and (legUp ? close > priceLvlExt : close < priceLvlExt)
tp2HitNow = tp2Hit and not tp2Hit[1]

// ---------------- Trade tracking ----------------
// One "trade" = one entry at 0.667. It stays open until TP2 or SL closes it. A
// loss only counts if SL is hit before TP1 was ever reached on that trade.
if correctionStarted and not tradeOpen
    tradeOpen   := true
    totalTrades += 1

if tradeOpen and tp1HitNow and not tp1Achieved
    tp1Achieved := true
    tp1Count    += 1

if tradeOpen and tp2HitNow
    tp2Count  += 1
    tradeOpen := false

if tradeOpen and slHitNow
    if not tp1Achieved
        lossCount += 1
    tradeOpen := false

resolvedTrades = tp1Count + lossCount
winRateTxt     = resolvedTrades > 0 ? str.tostring(tp1Count * 100.0 / resolvedTrades, "#.#") + "%" : "-"

// ---------------- Stats box ----------------
var table statsBox = table.new(position.top_right, 2, 6, border_width=1, border_color=color.gray, frame_color=color.gray, frame_width=1)

if barstate.islast
    table.cell(statsBox, 0, 0, "Trade Stats",  text_color=color.white, bgcolor=color.new(color.blue, 30),  text_size=size.small)
    table.cell(statsBox, 1, 0, "",             text_color=color.white, bgcolor=color.new(color.blue, 30),  text_size=size.small)
    table.cell(statsBox, 0, 1, "Entries",      text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 1, str.tostring(totalTrades), text_color=color.white,  bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 2, "TP1 hits",     text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 2, str.tostring(tp1Count),    text_color=color.aqua,   bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 3, "TP2 hits",     text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 3, str.tostring(tp2Count),    text_color=color.purple, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 4, "Losses (SL)",  text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 4, str.tostring(lossCount),   text_color=color.red,    bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 0, 5, "Win rate",     text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(statsBox, 1, 5, winRateTxt,     text_color=color.lime,  bgcolor=color.new(color.black, 40), text_size=size.small)

// ---------------- Entry / SL / TP lines ----------------
var line  lEntry    = na
var line  lSL       = na
var line  lTP1      = na
var line  lTP2      = na
var label lEntryTxt = na
var label lSLTxt    = na
var label lTP1Txt   = na
var label lTP2Txt   = na

if validLeg
    line.delete(lEntry)
    line.delete(lSL)
    line.delete(lTP1)
    line.delete(lTP2)
    label.delete(lEntryTxt)
    label.delete(lSLTxt)
    label.delete(lTP1Txt)
    label.delete(lTP2Txt)

    lEntry    := line.new(pointBTime, priceLvl667, time, priceLvl667, xloc=xloc.bar_time, color=color.lime, width=2)
    lSL       := line.new(pointBTime, priceLvl786, time, priceLvl786, xloc=xloc.bar_time, color=color.red,  width=2, style=line.style_dashed)
    lTP1      := line.new(pointBTime, priceLvl0,   time, priceLvl0,   xloc=xloc.bar_time, color=color.aqua,   width=2)
    lTP2      := line.new(pointBTime, priceLvlExt, time, priceLvlExt, xloc=xloc.bar_time, color=color.purple, width=2, style=line.style_dotted)
    lEntryTxt := label.new(bar_index, priceLvl667, "Entry " + str.tostring(priceLvl667, format.mintick), style=label.style_label_left, color=color.lime, textcolor=color.black, size=size.small)
    lSLTxt    := label.new(bar_index, priceLvl786, "Stop loss " + str.tostring(priceLvl786, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
    lTP1Txt   := label.new(bar_index, priceLvl0,   "TP1 " + str.tostring(priceLvl0, format.mintick), style=label.style_label_left, color=color.aqua, textcolor=color.black, size=size.small)
    lTP2Txt   := label.new(bar_index, priceLvlExt, "TP2 " + str.tostring(priceLvlExt, format.mintick), style=label.style_label_left, color=color.purple, textcolor=color.white, size=size.small)

if correctionStarted
    label.delete(lBuySellEntry)
    lBuySellEntry := label.new(bar_index, priceLvl667, legUp ? "Buy - Entry" : "Sell - Entry", style=legUp ? label.style_label_up : label.style_label_down, color=color.lime, textcolor=color.black, size=size.small)

if tp1HitNow
    label.delete(lTp1Hit)
    lTp1Hit := label.new(bar_index, priceLvl0, "TP1 hit", style=legUp ? label.style_label_up : label.style_label_down, color=color.aqua, textcolor=color.black, size=size.small)

if tp2HitNow
    label.delete(lTp2Hit)
    lTp2Hit := label.new(bar_index, priceLvlExt, "TP2 hit", style=legUp ? label.style_label_up : label.style_label_down, color=color.purple, textcolor=color.white, size=size.small)

alertcondition(correctionStarted, title="Entry alert at 0.667", message="Entry point: price reached the 0.667 level")
alertcondition(slHitNow, title="Stop loss alert at 0.786", message="Stop loss breached at the 0.786 level")
alertcondition(tp1HitNow, title="TP1 alert at level 0", message="Take profit 1 reached at level 0")
alertcondition(tp2HitNow, title="TP2 alert at level -1.3", message="Take profit 2 reached at the -1.3 extension level")
