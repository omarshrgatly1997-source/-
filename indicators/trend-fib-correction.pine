//@version=6
indicator("TB 5.1 - IRL -> ERL", overlay=true, max_lines_count=500, max_labels_count=200)

// ==========================================
// MARKET STRUCTURE SETTINGS
// ==========================================
grp_struct = "Market Structure"
showStructure = input.bool(true, "Show Connection Lines", group=grp_struct)
colStructBull = input.color(color.green, "Expansion Up (HH)", group=grp_struct)
colStructBear = input.color(color.red, "Expansion Down (LL)", group=grp_struct)
colStructInt  = input.color(color.gray, "Internal (LH/HL)", group=grp_struct)
widthStruct   = input.int(2, "Connection Width", group=grp_struct)
minBarsBetweenSwings = input.int(10, "Minimum Candles Between Swing Points", minval=1, group=grp_struct)
minMovePercent = input.float(0.1, "Minimum Move % Between Swing Points", minval=0.0, step=0.05, group=grp_struct)

grp_break = "Breaks (BOS / Touch)"
showBreakLines = input.bool(true, "Show Level Line From Each High/Low", group=grp_break)
colBOS         = input.color(color.white, "BOS Color (body closed through)", group=grp_break)
colTouch       = input.color(color.blue,  "Touch Color (wick only, level stays active)", group=grp_break)

// ==========================================
// SWING HIGH/LOW CONFIRMATION TRIGGER (3-candle imbalance)
// ==========================================
bullFVG = low > high[2]
bearFVG = low[2] > high

// A candidate swing point only counts if it moved far enough (%) from the last confirmed point -- filters out minor noise
f_bigEnoughMove(newPrice, refPrice) => not na(refPrice) and math.abs(newPrice - refPrice) / refPrice * 100 >= minMovePercent

// State tracking for structure
var int mode = 0
var float tempPeakPrice = na
var int tempPeakTime = 0
var float lastConfirmedPrice = na
var int lastConfirmedTime = 0
var int lastConfirmedBarIndex = 0

var float activeOldHighPrice = na
var int   activeOldHighTime  = na
var bool  highBroken         = true
var line  lineActiveHigh     = na

var float activeOldLowPrice = na
var int   activeOldLowTime  = na
var bool  lowBroken         = true
var line  lineActiveLow     = na

// ==========================================
// STRUCTURE UPDATE LOGIC (finds & confirms the swing high / swing low)
// ==========================================
if mode == 1 // Searching for a High
    if high > tempPeakPrice
        tempPeakPrice := high
        tempPeakTime := time

    if bearFVG and (bar_index - lastConfirmedBarIndex) >= minBarsBetweenSwings and f_bigEnoughMove(tempPeakPrice, lastConfirmedPrice)
        // Confirm the High (we came from Low -> High)
        bool isExpansion = not na(activeOldHighPrice) and tempPeakPrice > activeOldHighPrice

        if showStructure
            color legColor = isExpansion ? colStructBull : colStructInt
            line.new(lastConfirmedTime, lastConfirmedPrice, tempPeakTime, tempPeakPrice, xloc=xloc.bar_time, color=legColor, width=widthStruct)

        activeOldHighPrice := tempPeakPrice
        activeOldHighTime  := tempPeakTime
        highBroken         := false

        lastConfirmedPrice := tempPeakPrice
        lastConfirmedTime := tempPeakTime
        lastConfirmedBarIndex := bar_index
        mode := -1
        tempPeakPrice := low
        tempPeakTime := time

else if mode == -1 // Searching for a Low
    if low < tempPeakPrice
        tempPeakPrice := low
        tempPeakTime := time

    if bullFVG and (bar_index - lastConfirmedBarIndex) >= minBarsBetweenSwings and f_bigEnoughMove(tempPeakPrice, lastConfirmedPrice)
        // Confirm the Low (we came from High -> Low)
        bool isExpansion = not na(activeOldLowPrice) and tempPeakPrice < activeOldLowPrice

        if showStructure
            color legColor = isExpansion ? colStructBear : colStructInt
            line.new(lastConfirmedTime, lastConfirmedPrice, tempPeakTime, tempPeakPrice, xloc=xloc.bar_time, color=legColor, width=widthStruct)

        activeOldLowPrice := tempPeakPrice
        activeOldLowTime  := tempPeakTime
        lowBroken         := false

        lastConfirmedPrice := tempPeakPrice
        lastConfirmedTime := tempPeakTime
        lastConfirmedBarIndex := bar_index
        mode := 1
        tempPeakPrice := high
        tempPeakTime := time

else if mode == 0 // Start up
    if bullFVG
        mode := 1
        tempPeakPrice := high
        tempPeakTime := time
        lastConfirmedPrice := low[2]
        lastConfirmedTime := time[2]
        lastConfirmedBarIndex := bar_index - 2
        activeOldLowPrice := low[2]
        activeOldLowTime  := time[2]
        lowBroken         := false
    else if bearFVG
        mode := -1
        tempPeakPrice := low
        tempPeakTime := time
        lastConfirmedPrice := high[2]
        lastConfirmedTime := time[2]
        lastConfirmedBarIndex := bar_index - 2
        activeOldHighPrice := high[2]
        activeOldHighTime  := time[2]
        highBroken         := false

// ==========================================
// BREAK DETECTION (BOS / Touch) on the active (unbroken) high/low
// ==========================================
// BOS   = the breaking candle's body (close) closed through the level -> permanent white line, level marked broken.
// Touch = only the wick reached through it, the close stayed back inside -> permanent blue line, level stays active.
// The permanent line is a brand new, independent line object (not the reused
// "active" line variable) so it stays on the chart forever -- it never gets
// deleted when the next high/low cycle starts drawing its own preview line.
if not na(activeOldHighPrice) and not highBroken and high > activeOldHighPrice
    if close > activeOldHighPrice
        highBroken := true
        line.delete(lineActiveHigh)
        line.new(activeOldHighTime, activeOldHighPrice, time, activeOldHighPrice, xloc=xloc.bar_time, color=colBOS, style=line.style_solid, width=2)
    else
        line.new(activeOldHighTime, activeOldHighPrice, time, activeOldHighPrice, xloc=xloc.bar_time, color=colTouch, style=line.style_solid, width=2)

if not na(activeOldLowPrice) and not lowBroken and low < activeOldLowPrice
    if close < activeOldLowPrice
        lowBroken := true
        line.delete(lineActiveLow)
        line.new(activeOldLowTime, activeOldLowPrice, time, activeOldLowPrice, xloc=xloc.bar_time, color=colBOS, style=line.style_solid, width=2)
    else
        line.new(activeOldLowTime, activeOldLowPrice, time, activeOldLowPrice, xloc=xloc.bar_time, color=colTouch, style=line.style_solid, width=2)

if showBreakLines
    if not na(activeOldHighPrice) and not highBroken
        line.delete(lineActiveHigh)
        lineActiveHigh := line.new(activeOldHighTime, activeOldHighPrice, time, activeOldHighPrice, xloc=xloc.bar_time, color=colStructInt, style=line.style_dashed, width=1)

    if not na(activeOldLowPrice) and not lowBroken
        line.delete(lineActiveLow)
        lineActiveLow := line.new(activeOldLowTime, activeOldLowPrice, time, activeOldLowPrice, xloc=xloc.bar_time, color=colStructInt, style=line.style_dashed, width=1)
