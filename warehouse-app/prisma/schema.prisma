// سكيمة Prisma أولية لتطبيق إدارة المستودعات.
// تطبيق مباشر للتصميم الموثّق في ../docs/database-schema.md
//
// هذا الملف نقطة بداية للتنفيذ (المرحلة 0 في ../docs/roadmap.md) وليس بعد
// جزءًا من مشروع Next.js فعلي — سيُنسخ/يُدمج داخل مشروع warehouse-app عند
// تهيئته.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 1. الهوية والوصول (Identity & Access)
// ---------------------------------------------------------------------------

enum WarehouseRole {
  ADMIN
  WAREHOUSE_MANAGER
  STOREKEEPER
  ACCOUNTANT
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warehouseAccess UserWarehouseAccess[]
  auditLogs       AuditLog[]

  requestedTransfers StockTransfer[] @relation("TransferRequestedBy")
  approvedTransfers  StockTransfer[] @relation("TransferApprovedBy")
  stockMovements     StockMovement[]
  stockCounts        StockCount[]
  createdPOs         PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  createdSOs         SalesOrder[]
  deliveryNotes      DeliveryNote[]
  notifications      Notification[]

  @@index([email])
}

// دور المستخدم يختلف باختلاف المستودع: نفس الشخص ممكن يكون مدير في فرع
// ومشاهد فقط في فرع تاني.
model UserWarehouseAccess {
  id          String        @id @default(cuid())
  userId      String
  warehouseId String
  role        WarehouseRole
  createdAt   DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@index([warehouseId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // CREATE | UPDATE | DELETE | ...
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 2. الهيكل التنظيمي (Org Structure)
// ---------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  userAccess UserWarehouseAccess[]
  locations  WarehouseLocation[]
  settings   ProductWarehouseSetting[]

  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  stockCounts    StockCount[]

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  salesOrders    SalesOrder[]
  deliveryNotes  DeliveryNote[]

  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
}

// مواقع هرمية داخل المستودع: منطقة > رف > خانة
model WarehouseLocation {
  id              String   @id @default(cuid())
  warehouseId     String
  code            String
  name            String
  parentLocationId String?

  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parentLocation WarehouseLocation?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childLocations WarehouseLocation[] @relation("LocationHierarchy")

  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  countItems     StockCountItem[]

  @@unique([warehouseId, code])
}

// ---------------------------------------------------------------------------
// 3. كتالوج الأصناف (Product Catalog)
// ---------------------------------------------------------------------------

model Category {
  id       String  @id @default(cuid())
  name     String
  parentId String?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryHierarchy")
  products Product[]
}

model UnitOfMeasure {
  id     String @id @default(cuid())
  name   String
  symbol String @unique

  productsAsBase Product[]         @relation("BaseUnit")
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
}

// تحويل وحدات خاص بصنف معيّن (مثلاً: 1 كرتونة = 24 قطعة لهذا الصنف تحديدًا)
model UnitConversion {
  id         String @id @default(cuid())
  productId  String
  fromUnitId String
  toUnitId   String
  factor     Float // كمية fromUnit تساوي (factor × toUnit)

  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUnit UnitOfMeasure @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit   UnitOfMeasure @relation("ToUnit", fields: [toUnitId], references: [id])

  @@unique([productId, fromUnitId, toUnitId])
}

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  barcode        String?  @unique
  name           String
  description    String?
  categoryId     String?
  baseUnitId     String
  costPrice      Float    @default(0)
  salePrice      Float    @default(0)
  isBatchTracked Boolean  @default(false)
  isSerialTracked Boolean @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category Category?     @relation(fields: [categoryId], references: [id])
  baseUnit UnitOfMeasure  @relation("BaseUnit", fields: [baseUnitId], references: [id])

  unitConversions   UnitConversion[]
  warehouseSettings ProductWarehouseSetting[]
  batches           Batch[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  poItems           PurchaseOrderItem[]
  receiptItems      GoodsReceiptItem[]
  soItems           SalesOrderItem[]
  deliveryItems     DeliveryNoteItem[]
  transferItems     StockTransferItem[]
  countItems        StockCountItem[]

  @@index([categoryId])
}

// حدود مخزون مختلفة لنفس الصنف حسب المستودع (فرع ممكن يحتاج حد أدنى أعلى)
model ProductWarehouseSetting {
  id           String @id @default(cuid())
  productId    String
  warehouseId  String
  minStock     Float  @default(0)
  maxStock     Float?
  reorderPoint Float  @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

// ---------------------------------------------------------------------------
// 4. المخزون والحركة (Inventory & Movements)
// ---------------------------------------------------------------------------

model Batch {
  id             String    @id @default(cuid())
  productId      String
  batchNumber    String
  manufactureDate DateTime?
  expiryDate      DateTime?

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  receiptItems   GoodsReceiptItem[]
  deliveryItems  DeliveryNoteItem[]
  transferItems  StockTransferItem[]

  @@unique([productId, batchNumber])
  @@index([expiryDate])
}

// الرصيد الحالي: قيمة مُشتقة تُحدَّث من StockMovement — ليست مصدر الحقيقة.
model StockBalance {
  id          String  @id @default(cuid())
  productId   String
  warehouseId String
  locationId  String?
  batchId     String?
  quantity    Float   @default(0)

  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])
  batch     Batch?             @relation(fields: [batchId], references: [id])

  @@unique([productId, warehouseId, locationId, batchId])
  @@index([warehouseId])
}

enum StockMovementType {
  RECEIPT_IN
  ISSUE_OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  COUNT_CORRECTION
}

// سجل الحركة: مصدر الحقيقة الوحيد. لا يُعدَّل ولا يُحذف بعد إنشائه.
model StockMovement {
  id            String            @id @default(cuid())
  type          StockMovementType
  productId     String
  warehouseId   String
  locationId    String?
  batchId       String?
  quantity      Float // موجب للإدخال، سالب للإخراج
  referenceType String? // "PURCHASE_ORDER" | "SALES_ORDER" | "TRANSFER" | "STOCK_COUNT" | ...
  referenceId   String?
  userId        String?
  notes         String?
  createdAt     DateTime          @default(now())

  product   Product            @relation(fields: [productId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])
  batch     Batch?             @relation(fields: [batchId], references: [id])
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, warehouseId, createdAt])
  @@index([referenceType, referenceId])
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id             String         @id @default(cuid())
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(DRAFT)
  requestedById   String
  approvedById    String?
  transferDate    DateTime       @default(now())
  createdAt       DateTime       @default(now())

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  requestedBy   User      @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy    User?     @relation("TransferApprovedBy", fields: [approvedById], references: [id])

  items StockTransferItem[]
}

model StockTransferItem {
  id         String  @id @default(cuid())
  transferId String
  productId  String
  quantity   Float
  batchId    String?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
  batch    Batch?        @relation(fields: [batchId], references: [id])
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

model StockCount {
  id          String            @id @default(cuid())
  warehouseId String
  status      StockCountStatus  @default(DRAFT)
  countedById String
  countDate   DateTime          @default(now())

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  countedBy User             @relation(fields: [countedById], references: [id])
  items     StockCountItem[]
}

model StockCountItem {
  id         String  @id @default(cuid())
  countId    String
  productId  String
  locationId String?
  systemQty  Float
  countedQty Float
  variance   Float // countedQty - systemQty

  count    StockCount         @relation(fields: [countId], references: [id], onDelete: Cascade)
  product  Product            @relation(fields: [productId], references: [id])
  location WarehouseLocation? @relation(fields: [locationId], references: [id])
}

// ---------------------------------------------------------------------------
// 5. المشتريات (Purchasing)
// ---------------------------------------------------------------------------

model Supplier {
  id            String  @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?

  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  supplierId   String
  warehouseId  String
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  createdById  String

  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
}

model PurchaseOrderItem {
  id          String  @id @default(cuid())
  poId        String
  productId   String
  quantity    Float
  unitCost    Float
  receivedQty Float   @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
}

model GoodsReceipt {
  id           String   @id @default(cuid())
  poId         String
  warehouseId  String
  receivedDate DateTime @default(now())
  receivedById String

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  receivedBy    User          @relation(fields: [receivedById], references: [id])

  items GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id        String  @id @default(cuid())
  receiptId String
  productId String
  quantity  Float
  batchId   String?

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
  batch   Batch?       @relation(fields: [batchId], references: [id])
}

// ---------------------------------------------------------------------------
// 6. المبيعات / الصرف (Sales / Outbound)
// ---------------------------------------------------------------------------

model Customer {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  email   String?
  address String?

  salesOrders SalesOrder[]
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(cuid())
  customerId  String
  warehouseId String
  status      SalesOrderStatus @default(DRAFT)
  orderDate   DateTime         @default(now())
  createdById String

  customer  Customer  @relation(fields: [customerId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  items         SalesOrderItem[]
  deliveryNotes DeliveryNote[]
}

model SalesOrderItem {
  id        String @id @default(cuid())
  soId      String
  productId String
  quantity  Float
  unitPrice Float

  salesOrder SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
}

model DeliveryNote {
  id            String   @id @default(cuid())
  soId          String
  warehouseId   String
  deliveredDate DateTime @default(now())
  deliveredById String

  salesOrder  SalesOrder @relation(fields: [soId], references: [id])
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  deliveredBy User       @relation(fields: [deliveredById], references: [id])

  items DeliveryNoteItem[]
}

model DeliveryNoteItem {
  id         String  @id @default(cuid())
  deliveryId String
  productId  String
  quantity   Float
  batchId    String?

  delivery DeliveryNote @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product      @relation(fields: [productId], references: [id])
  batch    Batch?       @relation(fields: [batchId], references: [id])
}

// ---------------------------------------------------------------------------
// 7. التنبيهات (Reporting فوق الجداول الموجودة، بدون جداول خاصة بها)
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // LOW_STOCK | EXPIRY_WARNING | PO_APPROVAL_NEEDED | ...
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
